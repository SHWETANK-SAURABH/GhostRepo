# Copy to backend/.env for local development. Every value is optional; these are the defaults.

# Only directories inside this root can be investigated. Must be a dedicated folder.
# Default: <project>/workspace
# GHOSTREPO_WORKSPACE_ROOT=/absolute/path/to/your/repositories

# Local AI
GHOSTREPO_AI_ENABLED=true
GHOSTREPO_OLLAMA_ENDPOINT=http://localhost:11434
GHOSTREPO_OLLAMA_MODEL=gemma3:4b
# Hosts allowed to receive repository evidence. Add a host only if you control it.
GHOSTREPO_OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,::1,ollama,host.docker.internal
GHOSTREPO_AI_TIMEOUT_SECONDS=300
GHOSTREPO_AI_CONTEXT_TOKENS=8192

# Scan limits
GHOSTREPO_MAX_FILE_SIZE_BYTES=1000000
GHOSTREPO_MAX_SCAN_DEPTH=12
GHOSTREPO_MAX_SCAN_FILES=20000
GHOSTREPO_EXCLUDED_DIRS=.git,node_modules,.venv,venv,__pycache__,dist,build,target,.next,coverage
GHOSTREPO_ANALYSIS_TIMEOUT_SECONDS=120
GHOSTREPO_GIT_TIMEOUT_SECONDS=20
GHOSTREPO_MAX_CONCURRENT_INVESTIGATIONS=2

# HTTP
GHOSTREPO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GHOSTREPO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend: where Next.js forwards /api requests. Read at build time for production builds.
# BACKEND_URL=http://127.0.0.1:8000
